---
options:
  max_actions: 10
  max_concurrent_actions: 1
  crash_on_yield: false
deadlock_detection: false
---
# MCP lifecycle. last_tool is the latest call only (no growing history).

State = enum("UNINITIALIZED", "INITIALIZED")
ExposureMode = enum("DELEGATE", "DIRECT_FLAT", "DIRECT_DISCOVERY")
DocType = enum("NONE", "WRITER", "CALC", "DRAW")

action Init:
    status = State.UNINITIALIZED
    mode = ExposureMode.DELEGATE
    active_doc = DocType.WRITER
    last_error = None
    last_tool = ""
    last_call_mode = ExposureMode.DELEGATE

atomic action Initialize:
    require status == State.UNINITIALIZED
    status = State.INITIALIZED
    last_error = None

atomic action SwitchMode:
    mode = oneof [ExposureMode.DELEGATE, ExposureMode.DIRECT_FLAT, ExposureMode.DIRECT_DISCOVERY]

atomic action ChangeActiveDocument:
    active_doc = oneof [DocType.NONE, DocType.WRITER, DocType.CALC, DocType.DRAW]

atomic action ListTools:
    if status != State.INITIALIZED:
        last_error = "NOT_INITIALIZED"
    else:
        last_error = None
        last_tool = "tools/list"
        last_call_mode = mode

atomic action CallTool:
    tool_name = oneof ["apply_document_content", "get_document_content", "find_tools", "invalid_tool"]
    if status != State.INITIALIZED:
        last_error = "SERVER_NOT_INITIALIZED"
    elif tool_name == "invalid_tool":
        last_error = "UNKNOWN_TOOL"
    elif tool_name == "find_tools" and mode != ExposureMode.DIRECT_DISCOVERY:
        last_error = "UNKNOWN_TOOL"
    else:
        last_error = None
        last_tool = tool_name
        last_call_mode = mode

always assertion Inv_InitializedBeforeCalls:
    if status == State.UNINITIALIZED and last_tool != "":
        return False
    return True

always assertion Inv_FindToolsGating:
    if last_tool == "find_tools" and last_error == None:
        return last_call_mode == ExposureMode.DIRECT_DISCOVERY
    return True
