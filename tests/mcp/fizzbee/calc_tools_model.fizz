---
options:
  max_actions: 6
  max_concurrent_actions: 1
  crash_on_yield: false
deadlock_detection: false
---
# Calc sheets. Cell map is last-write-only to keep the state space tiny.

action Init:
    sheets = ["Sheet1"]
    active_sheet = "Sheet1"
    last_cell_key = ""
    last_cell_val = ""
    named_range_name = ""
    named_range_target = ""
    last_status = "OK"

atomic action WriteFormulaRange:
    cell_range = oneof ["A1", "B2"]
    val = oneof ["100", "Total"]
    last_cell_key = active_sheet + "!" + cell_range
    last_cell_val = val
    last_status = "OK"

atomic action ReadCellRange:
    cell_range = oneof ["A1", "B2"]
    key = active_sheet + "!" + cell_range
    if key == last_cell_key:
        last_status = "OK"
    else:
        last_status = "EMPTY_OR_DEFAULT"

atomic action CreateSheet:
    new_sheet = oneof ["Sheet2", "Summary"]
    found = False
    for s in sheets:
        if s == new_sheet:
            found = True
    if not found:
        sheets = sheets + [new_sheet]
        last_status = "OK"
    else:
        last_status = "ALREADY_EXISTS"

atomic action SwitchSheet:
    target_sheet = oneof ["Sheet1", "Sheet2", "Summary"]
    found = False
    for s in sheets:
        if s == target_sheet:
            found = True
    if found:
        active_sheet = target_sheet
        last_status = "OK"
    else:
        last_status = "SHEET_NOT_FOUND"

atomic action DeleteSheet:
    require len(sheets) > 1
    sheet_to_delete = oneof ["Sheet1", "Sheet2", "Summary"]
    remaining = []
    found = False
    for s in sheets:
        if s == sheet_to_delete:
            found = True
        else:
            remaining = remaining + [s]
    if found and len(remaining) >= 1:
        sheets = remaining
        if active_sheet == sheet_to_delete:
            active_sheet = sheets[0]
        last_status = "OK"
    else:
        last_status = "CANNOT_DELETE"

atomic action AddNamedRange:
    named_range_name = oneof ["SalesData", "TaxRate"]
    named_range_target = oneof ["Sheet1!A1:B10", "Sheet2!C1:C5"]
    last_status = "OK"

atomic action DeleteNamedRange:
    range_name = oneof ["SalesData", "TaxRate", "NonExistent"]
    if range_name == named_range_name:
        named_range_name = ""
        named_range_target = ""
        last_status = "OK"
    else:
        last_status = "NOT_FOUND"

always assertion Inv_SheetCountPositive:
    return len(sheets) >= 1

always assertion Inv_ActiveSheetMustExist:
    found = False
    for s in sheets:
        if s == active_sheet:
            found = True
    return found

always assertion Inv_NamedRangesIntegrity:
    return True
